{
  "manifest_version": 3,
  "name": "Agent Web CLI",
  "version": "0.1.0",
  "description": "Bridge Chrome to the local agent-web-cli (awc) host.",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "cookies",
    "debugger",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Web CLI"
  }
}
