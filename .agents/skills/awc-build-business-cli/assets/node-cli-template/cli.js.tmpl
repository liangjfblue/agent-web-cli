#!/usr/bin/env node
"use strict";

const { execFileSync } = require("node:child_process");
const {
  BOOLEAN_OPTIONS,
  buildAuthHeaders,
  isAuthRejected,
  printBusinessHelp,
  runBusinessCommand,
} = require("./commands");

const BASE_URL = process.env.__ENV_PREFIX___BASE_URL || "__BASE_URL__";
const AUTH_NAME = process.env.__ENV_PREFIX___AUTH_NAME || "__AUTH_NAME__";
const AWC_BIN = process.env.AWC_BIN || "awc";
const LOGIN_TIMEOUT_MS = 315_000;
const HTTP_METHODS = new Set(["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"]);

class CliError extends Error {
  constructor(message, exitCode = 1) {
    super(message);
    this.exitCode = exitCode;
  }
}

function buildLoginArgs(refresh) {
  const args = ["session:acquire", AUTH_NAME, "--url", BASE_URL, "--interactive"];
  if (refresh) args.push("--refresh");
  args.push("--json");
  return args;
}

function runAwc(args, timeout) {
  try {
    return execFileSync(AWC_BIN, args, {
      encoding: "utf8",
      timeout,
      stdio: ["ignore", "pipe", "pipe"],
    });
  } catch (error) {
    const code = Number(error.status) || 1;
    if (code === 10) throw new CliError("login required; run: __COMMAND_NAME__ login", 10);
    if (code === 11) throw new CliError("browser login timed out", 11);
    if ([20, 21, 22, 30].includes(code)) {
      throw new CliError("awc browser infrastructure is unavailable; run: awc sys:status", code);
    }
    throw new CliError("unable to acquire the Chrome session; run: awc sys:status", code);
  }
}

function parseSession(output) {
  let session;
  try {
    session = JSON.parse(output);
  } catch {
    throw new CliError("awc returned invalid JSON");
  }
  const cookieHeader = session?.data?.cookieHeader;
  if (!session?.ok || typeof cookieHeader !== "string" || !cookieHeader) {
    throw new CliError("awc did not return a usable browser session", 10);
  }
  return {
    cookieHeader,
    cookieValue(name) {
      const prefix = `${name}=`;
      const item = cookieHeader.split(";").map((part) => part.trim()).find((part) => part.startsWith(prefix));
      return item ? item.slice(prefix.length) : "";
    },
  };
}

function acquireSession() {
  return parseSession(runAwc([
    "session:acquire", AUTH_NAME, "--url", BASE_URL, "--json",
  ], 15_000));
}

function login(refresh) {
  parseSession(runAwc(buildLoginArgs(refresh), LOGIN_TIMEOUT_MS));
  console.log("Browser login is available.");
}

function prepareRequest(methodValue, bodyValue) {
  const method = String(methodValue || "GET").toUpperCase();
  if (!HTTP_METHODS.has(method)) throw new CliError(`unsupported HTTP method: ${method}`, 2);
  if ((method === "GET" || method === "HEAD") && bodyValue !== undefined) {
    throw new CliError(`${method} requests cannot include a body`, 2);
  }
  const body = bodyValue === undefined ? undefined : JSON.stringify(bodyValue);
  return {
    method,
    body,
    bodyHeaders: body === undefined ? {} : { "Content-Type": "application/json" },
  };
}

async function request(relativePath, options = {}) {
  const prepared = prepareRequest(options.method, options.body);

  const url = new URL(relativePath, `${BASE_URL}/`);
  for (const [key, value] of Object.entries(options.query || {})) {
    if (value !== undefined && value !== "") url.searchParams.set(key, String(value));
  }

  const session = acquireSession();
  const response = await fetch(url, {
    method: prepared.method,
    headers: {
      Accept: "application/json",
      ...buildAuthHeaders(session),
      ...prepared.bodyHeaders,
      ...(options.headers || {}),
    },
    body: prepared.body,
  });
  let responseBody;
  if (prepared.method === "HEAD" || response.status === 204) {
    responseBody = null;
  } else {
    try {
      responseBody = await response.json();
    } catch {
      throw new CliError(`business API returned non-JSON (HTTP ${response.status})`);
    }
  }
  if (isAuthRejected({ response, body: responseBody })) {
    throw new CliError("browser credentials were rejected; run: __COMMAND_NAME__ login --refresh", 10);
  }
  if (!response.ok) throw new CliError(responseBody?.message || responseBody?.msg || `business request failed (HTTP ${response.status})`);
  return responseBody;
}

function parseArgs(argv) {
  const command = argv[0] || "help";
  const positionals = [];
  const options = {};
  for (let i = 1; i < argv.length; i += 1) {
    const arg = argv[i];
    if (!arg.startsWith("--")) {
      positionals.push(arg);
      continue;
    }
    const key = arg.slice(2);
    if (BOOLEAN_OPTIONS.has(key) || key === "refresh") {
      options[key] = true;
      continue;
    }
    const value = argv[i + 1];
    if (!value || value.startsWith("--")) throw new CliError(`missing value for --${key}`, 2);
    options[key] = value;
    i += 1;
  }
  return { command, positionals, options };
}

function validateOptions(options, allowed) {
  for (const key of Object.keys(options)) {
    if (!allowed.includes(key)) throw new CliError(`unknown option: --${key}`, 2);
  }
}

function requirePositionals(positionals, count, usage) {
  if (positionals.length !== count) throw new CliError(`usage: ${usage}`, 2);
}

function positiveInt(value, name, fallback, max) {
  if (value === undefined) return fallback;
  if (!/^\d+$/.test(value) || Number(value) < 1) throw new CliError(`--${name} must be a positive integer`, 2);
  if (max !== undefined && Number(value) > max) throw new CliError(`--${name} must not exceed ${max}`, 2);
  return Number(value);
}

function printJSON(value) {
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
}

function printTable(columns, rows) {
  const widths = columns.map((column, index) => Math.max(column.length, ...rows.map((row) => String(row[index] ?? "").length)));
  const render = (row) => row.map((cell, index) => String(cell ?? "").padEnd(widths[index])).join("  ");
  console.log(render(columns));
  console.log(widths.map((width) => "-".repeat(width)).join("  "));
  for (const row of rows) console.log(render(row));
}

function printHelp() {
  console.log(`Usage: __COMMAND_NAME__ <command> [options]\n\nAuthentication:\n  login [--refresh]\n\nBusiness commands:`);
  printBusinessHelp();
}

async function main(argv = process.argv.slice(2)) {
  const parsed = parseArgs(argv);
  if (["help", "--help", "-h"].includes(parsed.command)) return printHelp();
  if (parsed.command === "login") {
    requirePositionals(parsed.positionals, 0, "__COMMAND_NAME__ login [--refresh]");
    validateOptions(parsed.options, ["refresh"]);
    return login(Boolean(parsed.options.refresh));
  }
  const handled = await runBusinessCommand(parsed, {
    CliError,
    positiveInt,
    printJSON,
    printTable,
    request,
    requirePositionals,
    validateOptions,
  });
  if (!handled) throw new CliError(`unknown command: ${parsed.command}`, 2);
}

if (require.main === module) {
  main().catch((error) => {
    console.error(error.message || String(error));
    process.exit(error.exitCode || 1);
  });
}

module.exports = { buildLoginArgs, LOGIN_TIMEOUT_MS, main, parseArgs, prepareRequest, request };
